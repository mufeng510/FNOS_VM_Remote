#!/bin/bash
# FNOS VM Remote — 配置变更（应用中心「设置」页）前校验。
# 在用户点击"保存"、FNOS 应用配置写入之前执行；失败则中止本次配置变更。
# 校验内容：端口合法性、范围、占用（排除本应用当前监听的端口）。
set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

PKGVAR="${TRIM_PKGVAR:?TRIM_PKGVAR 未设置}"
CONFIG_FILE="${PKGVAR}/config.json"
TEMPLOG="${TRIM_TEMP_LOGFILE:-/dev/stderr}"

fail() { echo "$*" >"$TEMPLOG"; echo "[config_init] $*" >&2; exit 1; }

NEW_PORT="${wizard_port:-}"
case "$NEW_PORT" in
  (*[!0-9]*|'') fail "端口非法: ${NEW_PORT:-<空>}（仅允许 1—65535 的整数）" ;;
esac
if [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
  fail "端口范围必须为 1—65535: ${NEW_PORT}"
fi

# 读取当前配置端口（无则视为默认 8321）
CUR_PORT=""
if [ -f "$CONFIG_FILE" ]; then
  CUR_PORT="$(grep -oE '"port"[[:space:]]*:[[:space:]]*[0-9]+' "$CONFIG_FILE" | head -n 1 | grep -oE '[0-9]+' | head -n 1)"
fi
[ -z "$CUR_PORT" ] && CUR_PORT=8321

if [ "$NEW_PORT" = "$CUR_PORT" ]; then
  echo "[config_init] 端口未变化（${NEW_PORT}），允许保存"
  exit 0
fi

# 占用检查（本应用即将迁移到该端口，端口不能被其他进程占用）
if (echo > "/dev/tcp/127.0.0.1/${NEW_PORT}") >/dev/null 2>&1; then
  fail "端口 ${NEW_PORT} 已被占用，请改用其他端口。"
fi

echo "[config_init] 端口 ${NEW_PORT} 可用（当前 ${CUR_PORT}）"
exit 0
